{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "getInfo 接口响应结构",
  "description": "/system/user/getInfo 接口的响应体结构校验",
  "type": "object",
  "required": ["code", "msg", "data"],
  "properties": {
    "code": {
      "type": "integer",
      "description": "业务状态码，200 表示成功"
    },
    "msg": {
      "type": "string",
      "description": "业务消息"
    },
    "data": {
      "type": "object",
      "required": ["user", "roles", "permissions"],
      "properties": {
        "parentDeptId": {
          "type": "integer"
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "user": {
          "type": "object",
          "required": ["userId", "userName", "deptId"],
          "properties": {
            "userId": { "type": "integer" },
            "tenantId": { "type": "string" },
            "deptId": { "type": "integer" },
            "userName": { "type": "string" },
            "avatar": { "type": ["string", "null"] },
            "createTime": { "type": "string" },
            "loginDate": { "type": ["string", "null"] },
            "loginIp": { "type": ["string", "null"] },
            "isPrivilege": { "type": "string" },
            "lockStatus": { "type": "string" }
          }
        }
      }
    }
  }
}
