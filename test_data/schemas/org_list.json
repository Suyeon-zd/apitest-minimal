{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "orgList 接口响应结构",
  "description": "组织列表 /orgList 的响应体结构契约（原文件是响应快照，无 type/properties 关键字，schema 断言形同虚设，已修正为真正的 JSON Schema）",
  "type": "object",
  "required": ["code", "msg", "data"],
  "additionalProperties": true,
  "properties": {
    "code": {
      "type": "integer"
    },
    "msg": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "deptId",
          "parentId",
          "ancestors",
          "deptName",
          "deptCategory",
          "orderNum",
          "status",
          "createTime",
          "updateTime",
          "type",
          "tenantId",
          "orgManLevel",
          "label",
          "id",
          "leaf"
        ],
        "properties": {
          "deptId": { "type": "integer" },
          "parentId": { "type": "integer" },
          "parentName": {},
          "ancestors": { "type": "string" },
          "deptName": { "type": "string" },
          "deptCategory": { "type": "string" },
          "orderNum": { "type": "integer" },
          "leader": {},
          "leaderName": {},
          "phone": {},
          "email": {},
          "status": { "type": "string" },
          "createTime": { "type": "string" },
          "updateTime": { "type": "string" },
          "type": { "type": "string" },
          "treeAddExtra": {},
          "tenantId": { "type": "string" },
          "orgManLevel": { "type": "string" },
          "label": { "type": "string" },
          "id": { "type": "integer" },
          "leaf": { "type": "boolean" }
        }
      }
    }
  }
}
