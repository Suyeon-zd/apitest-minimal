# .coveragerc - 覆盖率配置（配合 pytest-cov 使用）
#
# 用法：python -m pytest --cov --cov-report=term-missing
# 统计范围只包含框架自身的 core/ 与 api/；data/ 造数模块单独统计。
[run]
source =
    core
    api
branch = True

[report]
show_missing = True
skip_covered = True
# 这些行不计入覆盖率
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
